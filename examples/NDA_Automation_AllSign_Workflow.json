            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AllSign: Create NDA": {
      "main": [
        [
          {
            "node": "AllSign: Send NDA for Signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },

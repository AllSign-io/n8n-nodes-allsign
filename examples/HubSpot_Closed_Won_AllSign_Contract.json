        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.results[0].toObjectId }}?properties=firstname,lastname,email,phone,mobilephone,company,country",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "options": {}
      },
      "id": "778ff634-6d0d-5990-965c-52702eea46ae",
      "name": "Contact details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "hubspotAppToken": {
          "id": "",
          "name": "HubSpot App Token"
        }
